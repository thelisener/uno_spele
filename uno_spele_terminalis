class speletajs():
    def __init__(self, spel_vards: str):
        self.speletaja_kartis = []
        self.spel_vards = spel_vards
        self.nakamajam_speletajam = ""
        self.visas_kartis = len(self.speletaja_kartis) - self.speletaja_kartis.count("W4")
        self.karts = ""
    def pievienot_kartis(self, krava):
        for i in krava:
            self.speletaja_kartis.append(i)
            
    def izspelet_karti(self, kaudzes_karts):
        print([f"{i+1}.: {self.speletaja_kartis[i]}" for i in range(len(self.speletaja_kartis))])      
        turn = True
        
        while turn:
            
            # Ievade izvēlētajai kārtij
            cip = int(input(f"{self.spel_vards} Kuru kārti izspēlēt: "))
            
            # Pārbauda, vai kārts ar ievadīto ciparu
            if 0 < cip <= len(self.speletaja_kartis):
                
                # Izspēlētā kārts
                self.karts = self.speletaja_kartis[cip-1]
                
                #kārts simbols
                if len(self.karts) > 1:
                    simbols = self.karts[:-1]
                    #kārts krāsa
                    krasa = self.karts[-1]
                    
                else:
                    simbols = self.karts[0]
                    krasa = ''
                                        
                #print(f"krāsa: {krasa}")
                #print(f"simbols: {simbols}")
                
                # Salīdzina, kas ir simbols
                match simbols:
                    
                    case "W": # Kāda Wild kārts
                        match krasa:
                            case '': # Wild
                                match kaudzes_karts:
                                    case "W":
                                        print(f"jāizvēlas cita kārts")                                   
                                    case "W4":
                                        print(f"jāizvēlas cita kārts")
                                    case _:
                                        print(f"Kārts {self.karts} ir izspēlēta")
                                        turn = False
                               
                            case '4': # Wild draw 4
                                match kaudzes_karts:
                                    case "W" :
                                        print(f"jāizvēlas cita kārts")
                                    case"W4":
                                        print(f"jāizvēlas cita kārts")
                                    case _:
                                        # Ja vēlas izspēlēt "Wild draw four" kārti, jāpārbauda, vai pārējās kārtis ir izspēlējamas
                                        kura_karts = 0
                                        for k in self.speletaja_kartis:
                                            #kārts simbols
                                            if len(k) > 1:
                                                simb = k[:-1]
                                                #kārts krāsa
                                                kr = k[-1]
                                            else:
                                                simb = self.karts[0]
                                                kr = ''
                                            match kaudzes_karts.find(simb):
                                                case -1:
                                                    match k:
                                                        case "W":
                                                            print(f"jāizvēlas cita kārts")
                                                            break
                                                        case _:
                                                            match kaudzes_karts.find(kr):
                                                                case -1:
                                                                    kura_karts += 1
                                                                case _:
                                                                    print(f"jāizvēlas cita kārts")
                                                                    break
                                                case _:
                                                    print(f"jāizvēlas cita kārts")
                                                    break
                                        match kura_karts:
                                            case self.visas_kartis:
                                                print(f"Kārts {self.karts} ir izspēlēta")
                                                self.nakamajam_speletajam = "Jāuzņem 4 un jāizlaiž gājiens"
